<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.22000.0</TargetPlatformMinVersion>
    <RootNamespace>WinNote</RootNamespace>
    <AssemblyName>WinNote</AssemblyName>
    <Version>$(WinNoteVersion)</Version>
    <Product>WinNote</Product>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\WinNote.ico</ApplicationIcon>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- WinUI 3, unpackaged, runtime bundled next to the exe (no MSIX, no installer). -->
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>

    <!-- We provide our own Main (single-instance check before XAML starts). -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>

    <!-- Lean runtime settings: workstation, non-concurrent GC (no background GC thread). -->
    <ServerGarbageCollector>false</ServerGarbageCollector>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- Release publish: Native AOT (no JIT, trimmed, fast start, lower memory). -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PublishAot>true</PublishAot>
    <OptimizationPreference>Size</OptimizationPreference>
    <DebuggerSupport>false</DebuggerSupport>
    <EventSourceSupport>false</EventSourceSupport>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- Keep WinNote.pdb (31 MB) out of the publish folder; it stays in obj/ for debugging crashes. -->
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
  </PropertyGroup>

  <!--
    The app's resource index (compiled XAML, .xbf) must ship next to the exe. The full
    Microsoft.WindowsAppSDK metapackage adds it to the publish output; with the individual
    component packages we add it ourselves.
  -->
  <Target Name="PublishAppPri" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Include="$(OutDir)$(TargetName).pri" RelativePath="$(TargetName).pri"
                             CopyToPublishDirectory="PreserveNewest" Condition="Exists('$(OutDir)$(TargetName).pri')" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <Content Include="Assets\WinNote.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    Only the Windows App SDK components WinNote uses (the Microsoft.WindowsAppSDK 2.5.1 metapackage
    would also bundle AI/ONNX/DirectML, Search and Widgets: ~45 MB we never load).
    Versions are the ones the 2.5.1 metapackage pins.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK.Base" Version="2.0.4" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Foundation" Version="2.3.12" />
    <PackageReference Include="Microsoft.WindowsAppSDK.InteractiveExperiences" Version="2.1.9" />
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.3.9" />
    <PackageReference Include="Microsoft.WindowsAppSDK.DWrite" Version="2.1.0" />
  </ItemGroup>

</Project>
