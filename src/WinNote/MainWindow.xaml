<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WinNote.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WinNote.Controls"
    Title="WinNote">

    <Grid x:Name="Root" PreviewKeyDown="Root_PreviewKeyDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Custom title bar: drag area + pin / new / settings / hide. -->
        <Grid x:Name="TitleBar" Padding="14,0,4,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid x:Name="DragRegion" Background="Transparent">
                <TextBlock
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="WinNote" />
            </Grid>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                <Button x:Name="PinButton" AutomationProperties.Name="Pin on top" Click="PinButton_Click" Style="{StaticResource IconButtonStyle}"
                        ToolTipService.ToolTip="Pin on top">
                    <FontIcon x:Name="PinIcon" FontSize="14" Glyph="&#xE718;" />
                </Button>
                <Button x:Name="NewNoteButton" AutomationProperties.Name="New note" Click="NewNoteButton_Click" Style="{StaticResource IconButtonStyle}"
                        ToolTipService.ToolTip="New note (Ctrl+N)">
                    <FontIcon FontSize="14" Glyph="&#xE710;" />
                </Button>
                <Button x:Name="SettingsButton" AutomationProperties.Name="Settings" Click="SettingsButton_Click" Style="{StaticResource IconButtonStyle}"
                        ToolTipService.ToolTip="Settings">
                    <FontIcon FontSize="14" Glyph="&#xE713;" />
                </Button>
                <Button x:Name="HideButton" AutomationProperties.Name="Hide" Click="HideButton_Click" Style="{StaticResource IconButtonStyle}"
                        ToolTipService.ToolTip="Hide (Esc)">
                    <FontIcon FontSize="14" Glyph="&#xE921;" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Editor: a plain-text RichEditBox blended into the Mica background. -->
        <controls:NoteEditor
            x:Name="Editor"
            Grid.Row="1"
            Padding="14,4,14,8"
            BorderThickness="0"
            FontFamily="Segoe UI Variable Text"
            FontSize="15"
            PlaceholderText="Start typing…   ([ ] makes a todo)">
            <controls:NoteEditor.Resources>
                <ResourceDictionary>
                    <!-- Placeholder in Fluent's tertiary text colour. -->
                    <ResourceDictionary.ThemeDictionaries>
                        <ResourceDictionary x:Key="Default">
                            <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#8BFFFFFF" />
                            <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#8BFFFFFF" />
                            <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#8BFFFFFF" />
                        </ResourceDictionary>
                        <ResourceDictionary x:Key="Light">
                            <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#72000000" />
                            <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#72000000" />
                            <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#72000000" />
                        </ResourceDictionary>
                    </ResourceDictionary.ThemeDictionaries>
                <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="Transparent" />
                <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                </ResourceDictionary>
            </controls:NoteEditor.Resources>
        </controls:NoteEditor>

        <!-- Transient message with an optional action ("Note deleted · Undo"). -->
        <Border
            x:Name="Toast"
            Grid.Row="1"
            Margin="12,0,12,8"
            Padding="12,4,4,4"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Background="{ThemeResource SolidBackgroundFillColorTertiaryBrush}"
            BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="6"
            Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock x:Name="ToastText" MaxWidth="300" VerticalAlignment="Center" Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap" />
                <HyperlinkButton x:Name="ToastActionButton" Padding="8,4" Click="ToastActionButton_Click" />
            </StackPanel>
        </Border>

        <!-- Footer: note navigation on the left, note actions on the right. -->
        <Grid x:Name="Footer" Grid.Row="2" Padding="6,0,6,6">
            <Grid.Resources>
                <!-- Disabled nav arrows: just dim the glyph, no grey box. -->
                <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent" />
                <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="Transparent" />
            </Grid.Resources>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="PrevButton" AutomationProperties.Name="Previous note" Click="PrevButton_Click" Width="28" Height="28"
                        Style="{StaticResource IconButtonStyle}" ToolTipService.ToolTip="Previous note (Ctrl+←)">
                    <FontIcon FontSize="10" Glyph="&#xE76B;" />
                </Button>
                <TextBlock x:Name="PageText" MinWidth="40" VerticalAlignment="Center" TextAlignment="Center"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                           Style="{StaticResource CaptionTextBlockStyle}" Text="1 / 1" />
                <Button x:Name="NextButton" AutomationProperties.Name="Next note" Click="NextButton_Click" Width="28" Height="28"
                        Style="{StaticResource IconButtonStyle}" ToolTipService.ToolTip="Next note (Ctrl+→)">
                    <FontIcon FontSize="10" Glyph="&#xE76C;" />
                </Button>
            </StackPanel>

            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                <Button x:Name="CopyButton" AutomationProperties.Name="Copy note" Click="CopyButton_Click" Width="28" Height="28"
                        Style="{StaticResource IconButtonStyle}" ToolTipService.ToolTip="Copy note">
                    <FontIcon FontSize="13" Glyph="&#xE8C8;" />
                </Button>
                <Button x:Name="MoreButton" AutomationProperties.Name="More options" Width="28" Height="28"
                        Style="{StaticResource IconButtonStyle}" ToolTipService.ToolTip="More">
                    <FontIcon FontSize="13" Glyph="&#xE712;" />
                    <Button.Flyout>
                        <MenuFlyout Opening="MoreMenu_Opening" Placement="TopEdgeAlignedRight">
                            <MenuFlyoutItem x:Name="ClearCompletedItem" Click="ClearCompletedItem_Click" Text="Clear completed">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xEA99;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Click="ExportMenuItem_Click" Text="Export as .txt…">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74E;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Click="DeleteMenuItem_Click" KeyboardAcceleratorTextOverride="Ctrl+W" Text="Delete note">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </Grid>
        <!-- Settings view is created in code on first open (see MainWindow.Settings.cs). -->
        <Border x:Name="SettingsHost" Grid.Row="1" Grid.RowSpan="2" Visibility="Collapsed" />
    </Grid>
</Window>
