<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <!--
    Per-user install (no admin prompt): %LOCALAPPDATA%\Programs\WinNote, Start menu shortcut,
    entry in Settings > Apps. Notes and settings in %LOCALAPPDATA%\WinNote are never touched.

    perUserOrMachine + the default MSIINSTALLPERUSER=1 makes ProgramFiles64Folder resolve to
    %LOCALAPPDATA%\Programs for a per-user install.
  -->
  <Package Name="WinNote"
           Manufacturer="WinNote"
           Version="$(ProductVersion)"
           UpgradeCode="B417343F-855D-4A5A-A737-A4A1668B6BF9"
           Scope="perUserOrMachine"
           Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="A newer version of WinNote is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="WinNoteIcon" SourceFile="$(RepoRoot)src\WinNote\Assets\WinNote.ico" />
    <Property Id="ARPPRODUCTICON" Value="WinNoteIcon" />
    <Property Id="ARPNOMODIFY" Value="1" />
    <Property Id="ARPCOMMENTS" Value="Quick notes and todo lists for Windows 11" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="WinNote">
        <!-- Everything from the self-contained publish folder. -->
        <Files Include="$(AppDir)**" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut">
        <Shortcut Id="WinNoteShortcut"
                  Name="WinNote"
                  Description="Quick notes and todo lists"
                  Target="[INSTALLFOLDER]WinNote.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="WinNoteIcon" />
        <RegistryValue Root="HKCU" Key="Software\WinNote\Installer" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <!--
      Before files are replaced or removed, ask a running WinNote to save and exit.
      On a real uninstall (not an upgrade) also remove its "Start with Windows" entry.
      Both run the installed exe; if it's missing, the action is simply skipped.
    -->
    <CustomAction Id="CloseWinNote" Directory="INSTALLFOLDER"
                  ExeCommand="&quot;[INSTALLFOLDER]WinNote.exe&quot; --close"
                  Execute="immediate" Return="ignore" />
    <CustomAction Id="UninstallCleanup" Directory="INSTALLFOLDER"
                  ExeCommand="&quot;[INSTALLFOLDER]WinNote.exe&quot; --uninstall --user-sid [UserSID]"
                  Execute="immediate" Return="ignore" />
    <!-- Start WinNote after an interactive install (double-click); not for silent /qn installs. -->
    <CustomAction Id="LaunchWinNote" Directory="INSTALLFOLDER"
                  ExeCommand="&quot;[INSTALLFOLDER]WinNote.exe&quot;"
                  Execute="immediate" Return="asyncNoWait" />

    <InstallExecuteSequence>
      <Custom Action="UninstallCleanup" Before="InstallValidate"
              Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="CloseWinNote" After="UninstallCleanup"
              Condition="(Installed OR WIX_UPGRADE_DETECTED) AND NOT (REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE)" />
      <Custom Action="LaunchWinNote" After="InstallFinalize"
              Condition="NOT REMOVE AND UILevel &gt; 3" />
    </InstallExecuteSequence>
  </Package>
</Wix>
